{"at": "2026-10-08T07:41:06-07:00", "round": 1, "change_id": "C3-tighten-soft-claims", "kind": "variant", "layer": "judge_prompt", "hypothesis": "Judge passes soft/implied efficacy and ease-of-use claims (round-0 misses on a cortisol-lowering drug ad and a glucagon rescue-pen ad).", "change": {"id": "C3-tighten-soft-claims", "type": "judge_addendum", "payload": {"text": "Soft or implied claims are still claims. Wording that the product is easy, simple or foolproof to use, that users 'did it right', 'take control', or that monitoring lets them 'avoid' side effects is a representation about efficacy or safety: fail it when the label facts do not support it or when it understates required steps or risks."}, "layer": "judge_prompt"}, "target_metric": "single_sensitivity", "metrics": {"dev.judge_balanced_accuracy": {"before": 0.8266, "after": 0.7755, "delta": -0.0511}, "dev.single_sensitivity": {"before": 0.9456, "after": 0.966, "delta": 0.0204}, "dev.single_specificity": {"before": 0.7075, "after": 0.585, "delta": -0.1225}, "dev.pairwise_accuracy": {"before": 1.0, "after": 0.9966, "delta": -0.0034}, "dev.near_miss_balanced_accuracy": {"before": 0.946, "after": 0.8649, "delta": -0.0811}, "holdout.judge_balanced_accuracy": {"before": 0.8411, "after": 0.7915, "delta": -0.0496}, "holdout.single_sensitivity": {"before": 0.9322, "after": 0.9831, "delta": 0.0509}, "holdout.single_specificity": {"before": 0.75, "after": 0.6, "delta": -0.15}, "holdout.pairwise_accuracy": {"before": 0.9917, "after": 0.975, "delta": -0.0167}, "holdout.near_miss_balanced_accuracy": {"before": 0.9643, "after": 0.9285, "delta": -0.0358}}, "decision": "rejected", "reason": "dev judge_balanced_accuracy regressed -0.0511 (noise 0.0312); holdout judge_balanced_accuracy regressed -0.0496 (noise 0.0476); holdout pairwise_accuracy regressed -0.0167 (noise 0.0083); dev family A dropped -0.0865", "approved_by": "owner request (phase-3 task message)", "cost_usd": 0.31961, "judge_results": "judge/results/loop_r
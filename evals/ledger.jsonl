{"at": "2026-10-08T07:29:55-07:00", "round": 1, "change_id": "C1-reminder-boxed-warning", "kind": "variant", "layer": "rule_text", "hypothesis": "A-202-E2-01 omits the 202.1(e)(2)(i) bar on reminder ads for boxed-warning drugs and the \"name + optional non-promotional details only\" limit, so the judge passes reminder pieces it should fail.", "change": {"id": "C1-reminder-boxed-warning", "type": "rule_override", "payload": {"rule_id": "A-202-E2-01", "rule_text": "Reminder ads (exempt from brief summary) may contain only the proprietary and established names plus optional non-promotional details (dosage form, package quantity, price, manufacturer) and no indication, dosage recommendation, or other representation about the drug. Reminder ads are not permitted at all for a drug whose labeling has a boxed warning (except price-only ads under 21 CFR 200.200). A piece that names the product and its use is not a reminder ad and needs full risk disclosure."}, "layer": "rule_text"}, "target_metric": "judge_balanced_accuracy", "metrics": {"dev.judge_balanced_accuracy": {"before": 0.8232, "after": 0.8266, "delta": 0.0034}, "dev.single_sensitivity": {"before": 0.9388, "after": 0.9456, "delta": 0.0068}, "dev.single_specificity": {"before": 0.7075, "after": 0.7075, "delta": 0.0}, "dev.pairwise_accuracy": {"before": 1.0, "after": 1.0, "delta": 0.0}, "dev.near_miss_balanced_accuracy": {"before": 0.9325, "after": 0.946, "delta": 0.0135}, "holdout.judge_balanced_accuracy": {"before": 0.8411, "after": 0.8411, "delta": 0.0}, "holdout.single_sensitivity": {"before": 0.9322, "after": 0.9322, "delta": 0.0}, "holdout.single_specificity": {"before": 0.75, "after": 0.75, "delta": 0.0}, "holdout.pairwise_accuracy": {"before": 0.9917, "after": 0.9917, "delta": 0.0}, "holdout.near_miss_balanced_accuracy": {"before": 0.9643, "after": 0.9643, "delta": 0.0}}, "decision": "accepted_pending_human_review", "reason": "dev judge_balanced_accuracy +0.0034; no holdout/slice regression beyond noise", "app